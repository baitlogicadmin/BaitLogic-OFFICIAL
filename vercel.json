{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/barometer", "destination": "/public/barometer.html" },
    { "source": "/barometer.html", "destination": "/public/barometer.html" },
    { "source": "/nature-check", "destination": "/public/nature-check.html" },
    { "source": "/nature-check.html", "destination": "/public/nature-check.html" },
    { "source": "/(.*)", "destination": "/public/$1" }
  ]
}
